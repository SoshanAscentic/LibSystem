{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "LibSystem": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/library-system-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}