{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LibrarySystem;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true;Encrypt=false",
    "IdentityConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LibraryIdentity;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true;Encrypt=false"
  },

  "JwtSettings": {
    "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLong12345!",
    "Issuer": "LibrarySystem",
    "Audience": "LibrarySystem.Api",
    "ExpirationInMinutes": 15, // Shorter for access tokens
    "RefreshTokenExpirationInDays": 7
  },
  "Security": {
    "EnableIpFiltering": false,
    "AllowedIPs": [ "127.0.0.1", "::1" ],
    "CookieSettings": {
      "SecurePolicy": "Always",
      "SameSiteMode": "Strict",
      "HttpOnly": true
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://yourdomain.com" ],
    "AllowCredentials": true
  },

  "Cookies": {
    "SecurePolicy": "Always",
    "SameSiteMode": "Strict",
    "HttpOnly": true
  },

  "DatabaseSettings": {
    "UseMigrations": false,
    "SeedData": true
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "LibSystem": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/library-system-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}